# Copy to .env.local and fill in. NEVER commit .env.local.
# NEXT_PUBLIC_ prefixed values are safe to expose in the client build.

# Public site URL (used for metadata/referral links). Set in .env.local and Vercel.
NEXT_PUBLIC_APP_URL=https://techhub.icreatitbrandagency.com

# Convex (NEXT_PUBLIC_CONVEX_URL and CONVEX_DEPLOYMENT are written automatically by `convex dev`)
NEXT_PUBLIC_CONVEX_URL=

# --- Secrets: store in Convex env vars (npx convex env set) and Vercel, not in the client ---

# Brevo (transactional email + automations)
BREVO_API_KEY=

# Telegram bot (single-use invite links via createChatInviteLink)
TELEGRAM_BOT_TOKEN=

# CEO strategy call notifications
CEO_NOTIFICATION_EMAIL=
