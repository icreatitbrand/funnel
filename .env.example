# Copy to .env.local and fill in. NEVER commit .env.local.
# NEXT_PUBLIC_ prefixed values are safe to expose in the client build.

# Public site URL (used for metadata/referral links). Set in .env.local and Vercel.
NEXT_PUBLIC_APP_URL=https://techhub.icreatitbrandagency.com

# Convex (NEXT_PUBLIC_CONVEX_URL and CONVEX_DEPLOYMENT are written automatically by `convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://giddy-retriever-670.eu-west-1.convex.cloud

# --- Secrets: store in Convex env vars (npx convex env set) and Vercel, not in the client ---

# Brevo (transactional email + automations)
BREVO_API_KEY=

# Paystack (payments for the paid tier; test keys for dev, live keys for prod)
PAYSTACK_SECRET_KEY=sk_test_00000000000000000000000000000000000
PAYSTACK_PUBLIC_KEY=pk_test_00000000000000000000000000000000000

# Telegram bot (single-use invite links for the PAID Telegram group)
TELEGRAM_BOT_TOKEN=

# CEO strategy call notifications
CEO_NOTIFICATION_EMAIL=

# NOTE (v1.3): the CEO's WhatsApp number and the approved prefilled message
# are runtime settings, not env vars. Defaults live in convex/settings.ts
# (ceoWhatsappNumber / whatsappMessageTemplate) and can be changed without a
# deploy via convex/ops.ts setSetting (OPS_SECRET, already set on the dev
# deployment).
